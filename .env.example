# NEXUS API environment template. NO REAL VALUES BELONG IN THIS FILE.
# The mobile app holds none of these; every credential stays server-side.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- required: the process refuses to start without these ---
DATABASE_URL=
# Minimum 32 bytes. A shorter HMAC secret is brute-forceable offline.
JWT_SECRET=
# Unique per running process, 1-4 Crockford base32 chars ([0-9A-HJKMNP-TV-Z]).
# IdSequence uniqueness depends on it: two instances sharing a node id can
# mint colliding record ids.
NEXUS_NODE_ID=A1

# --- optional ---
JWT_ISSUER=nexus
JWT_AUDIENCE=nexus-mobile
NEXUS_VERSION=1.0.0

# --- provider credentials: server-side only, never in the app bundle ---
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=
